{
  "name": "kern",
  "version": "0.1.0",
  "private": true,
  "description": "Kern demo storefront and promise oracle (first slice)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "app": "node src/app/server.ts",
    "dev": "node scripts/dev.ts",
    "demo": "node scripts/demo.ts",
    "gate": "node scripts/gate.ts",
    "test": "node --test tests/*.test.ts",
    "test:replay": "node --test tests/replay/pre-repair.test.ts",
    "demo:replay-pre-repair": "node scripts/demo-replay-pre-repair.ts",
    "demo:store-pre-repair": "node scripts/demo-store-pre-repair.ts",
    "contract:freeze": "node scripts/freeze-contract.ts",
    "typecheck": "tsc --noEmit",
    "verify:vercel": "node scripts/vercel-simulate.ts",
    "app:recorded": "node scripts/app-recorded.ts",
    "export:static": "node scripts/export-static.ts http://127.0.0.1:3300 && node scripts/export-store.ts && node scripts/export-store-before.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}